{
  "name": "Pokemon Card Trading Platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:ci": "NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_ANON_KEY= next build",
    "start": "next start",
    "lint": "eslint",
    "supabase:types": "bunx supabase gen types typescript --linked > types/supabase.ts && bun run scripts/generate-supabase-md.ts",
    "test:catalog-search": "bun run scripts/test-product-catalog-search.ts",
    "test:member-order-complete-rpc": "bun run scripts/test-member-order-complete-rpc.ts",
    "test:chat-mark-read": "bun run scripts/test-chat-mark-read.ts",
    "test:member-auth-mock-flow": "bun run scripts/run-member-auth-mock-flow.ts",
    "stripe:webhook:listen": "bash scripts/stripe-webhook-listen.sh",
    "stripe:webhook:sync": "bun run scripts/stripe-webhook-sync-endpoint.ts",
    "test:e2e": "playwright test",
    "test:e2e:rewards": "playwright test e2e/platform-rewards-phase2.spec.ts e2e/platform-rewards-phase3.spec.ts e2e/platform-rewards-matrix.spec.ts --project=setup --project=guest --project=buyer",
    "test:e2e:rewards-gate": "playwright test e2e/platform-rewards-phase2.spec.ts e2e/platform-rewards-phase3.spec.ts e2e/platform-rewards-matrix.spec.ts e2e/rewards-checkout-coupon.spec.ts e2e/rewards-order-detail.spec.ts e2e/platform-rewards-stripe-reconcile.spec.ts --project=setup --project=guest --project=buyer",
    "test:e2e:rewards-checkout-coupon": "playwright test e2e/rewards-checkout-coupon.spec.ts e2e/rewards-order-detail.spec.ts --project=setup --project=buyer",
    "test:e2e:stripe-reconcile": "playwright test e2e/platform-rewards-stripe-reconcile.spec.ts --project=setup --project=buyer",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:integration:rewards": "vitest run --config vitest.config.mts tests/integration/rewards",
    "test:integration:rewards:pbt": "vitest run --config vitest.config.mts tests/integration/rewards/coupon-pbt.integration.test.ts",
    "test:rewards:gate": "bash scripts/rewards-release-gate.sh",
    "test:rewards:mutation": "stryker run",
    "test:integration:moderation": "vitest run --config vitest.config.mts tests/integration/moderation"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@serwist/next": "^9.5.11",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "3.8.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/swc-linux-x64-gnu": "16.2.9",
    "@playwright/test": "^1.61.1",
    "@serwist/turbopack": "^9.5.7",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fast-check": "^4.9.0",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
